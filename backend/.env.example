DATABASE_URL=postgresql+psycopg://pathways:pathways@localhost:5432/pathways
# Comma-separated exact frontend origins; no wildcard or URL path.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Disabled by default. Explicit PostgreSQL session_user allowlist for local content CLI.
PATHWAYS_CONTENT_REVIEW_ROLES=
